<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick Settings Tile icon for Grayscale toggle.
    A circle split vertically: left half filled (black), right half outlined (white).
    Classic "contrast / color mode" symbol.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Full circle outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:pathData="M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2 Z" />

    <!-- Left half filled (black/dark) — semicircle left -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,2 A10,10 0 0,0 12,22 Z" />

</vector>
